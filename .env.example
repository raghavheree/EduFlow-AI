# EduFlow AI — Production Environment Variables Template
# Copy this file to .env and provide your credentials.
# In development/hackathon demo mode, the application runs fully functional
# even if external API credentials are not yet set.

# 1. Supabase PostgreSQL & Auth (Required for live database sync)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Google Gemini AI API (Server-Side Secret - Never expose in frontend VITE_ variables!)
# Set as a server secret in your Supabase Edge Function environment:
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key
# Or in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets.
# Optional custom backend AI proxy URL if self-hosting without Supabase Edge Functions:
# VITE_AI_PROXY_URL=https://your-domain.com/api/ai

# 3. Resend Email Dispatch API (Optional: enables live SMTP delivery for circulars)
VITE_RESEND_API_KEY=re_your_resend_api_key

# 4. Academic Institution Settings
VITE_APP_NAME="EduFlow AI"
VITE_APP_ENV="development"
VITE_CAMPUS_NAME="Apex Institute of Technology"
VITE_ACADEMIC_YEAR="2026-2027"
VITE_CURRENT_TERM="Fall 2026"
